# ═══════════════════════════════════════════════════════════════
#  AI Emergency Response Platform — Environment Variables
#  Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# ─── Clerk Authentication ─────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YWJzb2x1dGUtbXVsZS02NzM5LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_OjQ0hg8JM7Q8t73aEMuterLkDrqOSHBjTFxpbmailj

# ─── FastAPI ──────────────────────────────────────────────────
APP_SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database ─────────────────────────────────────────────────
# SQLite (default, no setup required)
DATABASE_URL=sqlite:///./disaster_platform.db

# PostgreSQL (uncomment to use instead)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/disaster_platform

# ─── Redis (optional, for caching + real-time) ────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ─── External Data APIs ───────────────────────────────────────
# OpenWeatherMap: https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_openweather_api_key

# USGS Earthquake — no key needed (free public API)
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary

# NASA EONET — no key needed (free public API)
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3

# ─── Alert / Notification Services ───────────────────────────
# Twilio SMS: https://twilio.com (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Dataset Paths ────────────────────────────────────────────
DATASET_PATH=disaster_Dataset_FINAL.csv
ML_MODELS_DIR=ml/models
